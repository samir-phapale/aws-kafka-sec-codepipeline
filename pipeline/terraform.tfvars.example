aws_region   = "us-east-1"
project_name = "kafka-on-ec2-cp"
environment  = "dev"

github_repository = "REPLACE_OWNER/aws-kafka-sec-codepipeline"
branch            = "main"

tf_state_bucket = "REPLACE_WITH_YOUR_TERRAFORM_STATE_BUCKET"
